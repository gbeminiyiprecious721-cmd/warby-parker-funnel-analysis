table funnel
	lineageTag: b2aa9c77-56a3-44b6-9260-ed75be06b9ce

	/// Number of customers who completed the quiz.
	measure 'Quiz Customers' = COUNTROWS(funnel)
		lineageTag: 9530acd0-4a50-4ac0-9957-ad7fcc11a6d1

	/// Number of quiz customers who received a Home Try-On box.
	measure 'Home Try-On Customers' = SUM(funnel[got_home_try_on])
		lineageTag: 5c080c58-5347-446d-9fb9-e584d5be681c

	/// Number of quiz customers who made a purchase.
	measure Purchases = SUM(funnel[purchased])
		lineageTag: 71bf7bae-2f2a-4c58-91f5-02f875d6d6e6

	/// Percentage of quiz customers who received a Home Try-On box.
	measure 'Quiz-to-Try-On Conversion' = DIVIDE([Home Try-On Customers], [Quiz Customers])
		formatString: 0.0%
		lineageTag: 4955776e-a87b-4c07-bd4e-3d8f59f76adb

	/// Purchase customers divided by Home Try-On customers.
	measure 'Try-On-to-Purchase Conversion' = DIVIDE([Purchases], [Home Try-On Customers])
		formatString: 0.0%
		lineageTag: 207f0884-6cc3-44f9-8b52-3c016f42b993

	/// Percentage of quiz customers who made a purchase.
	measure 'Overall Purchase Conversion' = DIVIDE([Purchases], [Quiz Customers])
		formatString: 0.0%
		lineageTag: 9e11774b-8d9b-4976-abca-82190f53d69e

	/// Purchase rate among Home Try-On customers offered 3 pairs.
	measure '3-Pair Purchase Rate' =
			CALCULATE(
			    [Try-On-to-Purchase Conversion],
			    funnel[number_of_pairs] = "3 pairs"
			)
		formatString: 0.0%
		lineageTag: b3709dad-9405-40f0-ae84-ebb11ac07fa3

	/// Purchase rate among Home Try-On customers offered 5 pairs.
	measure '5-Pair Purchase Rate' =
			CALCULATE(
			    [Try-On-to-Purchase Conversion],
			    funnel[number_of_pairs] = "5 pairs"
			)
		formatString: 0.0%
		lineageTag: 25eda09f-8777-4d13-861b-905e4b8b0595

	/// 5-pair purchase rate minus 3-pair purchase rate, interpreted in percentage points.
	measure 'Purchase Rate Difference' = [5-Pair Purchase Rate] - [3-Pair Purchase Rate]
		formatString: 0.0%
		lineageTag: 83b497c9-dec8-4147-a7e7-d7503beb9b2a

	column user_id
